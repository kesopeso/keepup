# Optional for the Android emulator in development. Restart Metro after changing it.
# Physical devices need a reachable host address; release builds need their own API URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Opt in only against an account-enabled backend. A2 supplies native route integration.
EXPO_PUBLIC_AUTH_ENABLED=false
# Web/server OAuth client ID used as the native ID-token audience. Public, not a secret.
# Register the Android package and debug/release signing fingerprints in Google Cloud.
# EXPO_PUBLIC_GOOGLE_SERVER_CLIENT_ID=123.apps.googleusercontent.com
# HTTPS origin approved for Android App Links, without a path or port.
# Host /.well-known/assetlinks.json with this package and release signing fingerprints.
# EXPO_PUBLIC_AUTH_LINK_ORIGIN=https://keepup.example
