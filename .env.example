# API
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://keepup:keepup@postgres:5432/keepup?sslmode=disable
DATABASE_STARTUP_TIMEOUT=20s
DEFAULT_MAX_TRACKING_MEMBERS=10

# Email delivery. Log previews do not send mail and work in any environment.
# Authentication still requires its own enablement, origin and outbox settings.
EMAIL_PROVIDER=log

# Database
POSTGRES_DB=keepup
POSTGRES_USER=keepup
POSTGRES_PASSWORD=keepup
