# API
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://keepup:keepup@postgres:5432/keepup?sslmode=disable
DATABASE_STARTUP_TIMEOUT=20s
DEFAULT_MAX_TRACKING_MEMBERS=10

# Email delivery. Log previews do not send mail and work in any environment.
# Authentication requires origin and outbox settings below.
EMAIL_PROVIDER=log

# Accounts are required. Apply migrations through 0007 before starting the API.
# Optional isolated local account database, preserving the legacy database volume:
# COMPOSE_FILE=docker-compose.yml:docker-compose.auth.yml
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_PUBLIC_URL=http://localhost:3000
# Generate a persistent random key with: openssl rand -base64 32
AUTH_OUTBOX_KEY=
AUTH_SESSION_IDLE=720h
# Exact trusted ingress CIDRs only. Empty ignores forwarded source headers.
AUTH_TRUSTED_PROXIES=

# Optional Google public client IDs. Password login works without them.
AUTH_GOOGLE_WEB_CLIENT_ID=
AUTH_GOOGLE_WEB_CLIENT_IDS=
AUTH_GOOGLE_NATIVE_CLIENT_IDS=
# Public SHA-256 signing certificate fingerprints, comma-separated, colon-delimited.
# Empty publishes no Android domain association. Use the actual installed APK signer.
ANDROID_APP_LINK_SHA256_FINGERPRINTS=

# Required only with EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls

# Database
POSTGRES_DB=keepup
POSTGRES_USER=keepup
POSTGRES_PASSWORD=keepup
